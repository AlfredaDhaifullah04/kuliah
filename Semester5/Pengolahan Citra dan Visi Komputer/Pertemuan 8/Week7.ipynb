× T)\ntitles = ['Citra Asli', 'Flood T=5', 'Flood T=20', 'Flood T=60']\nimages = [citra_coins, mask_T5, mask_T20, mask_T60]\n\nplt.figure(figsize=(12, 10))\nfor i in range(4):\n    plt.subplot(2, 2, i+1)\n    if i == 0:\n        plt.imshow(images[i], 'gray')\n    else:\n        plt.imshow(images[i], cmap='nipy_srain')\n    plt.title(titles[i])\n    plt.xticks([]), plt.yticks([])\n    if i > 0:\n        plt.title(f'{titles[i]} ({pixel_count_T5 if i==1 else pixel_count_T20 if i==2 else pixel_count_T60} piksel)')\n\n# Catat jumlah piksel per toleransi di bawah plot\nplt.text(20, 200, f'Toleransi T=5: {pixel_count_T5} piksel', fontsize=10)\nplt.text(20, 180, f'Toleransi T=20: {pixel_count_T20} piksel', fontsize=10)\nplt.text(20, 160, f'Toleransi T=60: {pixel_count_T60} piksel', fontsize=10)\nplt.suptitle('Tugas 6: Segmentasi Berbasis Wilayah dengan Flood Fill', fontsize=14)\nplt.tight_layout()\nplt.show()\n\nprint(\"\\nSummary Segmentasi Flood Fill:\")\nprint(f\"T=5: {pixel_count_T5} piksel - Region kecil di sekitar seed\")\nprint(f\"T=20: {pixel_count_T20} piksel - Region menengah\")\nprint(f\"T=60: {pixel_count_T60} piksel - Region besar, mungkin meliputi multiple koin\")
