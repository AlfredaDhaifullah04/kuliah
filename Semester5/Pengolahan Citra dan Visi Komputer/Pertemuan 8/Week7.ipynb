print("Tesseract and pytesseract berhasil diinstall!")

# Siapkan 3 jenis citra masukan dari KTP
import cv2
import numpy as np
import pytesseract
from google.colab.patches import cv2_imshow
import pandas as pd
from PIL import Image

# Muat citra KTP (pastikan citra sudah diupload ke Drive)
ktp_asli_path = '/content/drive/MyDrive/PCVK/Images/ktp_fulan.jpg'
ktp_asli = cv2.imread(ktp_asli_path)

if ktp_asli is None:
    print("Citra KTP tidak ditemukan, menggunakan citra contoh")
    from skimage import data
    # Buat citra contoh jika tidak ada
    ktp_asli = np.random.randint(0, 256, (800, 600, 3), dtype=np.uint8)

# Ubah citra ke ukuran yang konsisten (misalnya 800x600)
ktp_asli_resized = cv2.resize(ktp_asli, (800, 600))

# --- Citra 1: Berwarna Asli ---
ctp_color = ktp_asli_resized.copy()

# --- Citra 2: Hasil Global Thresholding Otsu (grayscale) ---
ktp_gray = cv2.cvtColor(ktp_asli_resized, cv2.COLOR_BGR2GRAY)
# Terapkan Otsu thresholding
_, ctps_otsu = cv2.threshold(ktp_gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

# --- Citra 3: Hasil Adaptive Thresholding Mean (grayscale) ---
# Adaptive threshold dengan block size 11, C=2
ctps_adaptive = cv2.adaptiveThreshold(ktp_gray, 255, cv2.ADAPTIVE_THRESH_MEAN_C,
                                     cv2.THRESH_BINARY, 11, 2)

# Function untuk membaca teks dengan pytesseract
def baca_teks(citra, nama_citra):
    # Konversi ke PIL Image untuk pytesseract
    if len(citra.shape) == 3:
        citra_pil = Image.fromarray(cv2.cvtColor(citra, cv2.COLOR_BGR2RGB))
    else:
        citra_pil = Image.fromarray(citra)

    # Baca teks dengan bahasa Indonesia dan pengaturan PSM 6
    teks = pytesseract.image_to_string(citra_pil, lang='ind', config='--psm 6')

    # Dapatkan data posisi teks dan confidence
    data = pytesseract.image_to_data(citra_pil, lang='ind', output_type=pytesseract.Output.DICT)

    # Deteksi area teks dengan confidence > 60 dan gambar kotak hijau
    kotak_hijau = citra.copy()
    daftar_kotak = []
    for i in range(len(data['text'])):
        if int(data['conf'][i]) > 60 and data['text'][i].strip() != '':
            x, y, w, h = data['left'][i], data['top'][i], data['width'][i], data['height'][i]
            cv2.rectangle(kotak_hijau, (x, y), (x + w, y + h), (0, 255, 0), 2)
            daftar_kotak.append({
                'text': data['text'][i],
                'confidence': int(data['conf'][i]),
                'x': x, 'y': y, 'w': w, 'h': h
            })

    return teks, kotak_hijau, daftar_kotak, data

# Lakukan pembacaan teks untuk ketiga citra
teks_color, kotak_color, daftar_kotak_color, data_color = baca_teks(ctp_color, "Berwarna")
teks_otsu, kotak_otsu, daftar_kotak_otsu, data_otsu = baca_teks(ctps_otsu, "Otsu")
teks_adaptive, kotak_adaptive, daftar_kotak_adaptive, data_adaptive = baca_teks(ctps_adaptive, "Adaptive")

# Buat tabel perbandingan 10 kata/angka acuan (NIK, Nama, TL, dll.)
# Kita ambil 10 item pertama dari setiap metode berdasarkan urutan muncul
n_items = 10
print(f"\n=== TABEL PERBANDINGAN OCR (10 KATA/ANGKA ACUAN) ===")

# Daftar nama kolom tabel
kolom_tabel = ["No.", "Teks Sebenarnya", "OCR Berwarna", "OCR Otsu", "OCR Adaptive"]

# Ambil 10 item dari setiap metode (menggunakan teks yang terbaca)
baris_tabel = []
for no in range(1, n_items + 1):
    # Ambil teks dari masing-masing metode (ambil jika ada, jika tidak maka '-' )
    teks_sebenarnya = ""  # Akan diisi dari visual KTP secara manual
    ocr_berwarna = daftar_kotak_color[no-1]['text'] if no-1 < len(daftar_kotak_color) else "-"
    ocr_otsu = daftar_kotak_otsu[no-1]['text'] if no-1 < len(daftar_kotak_otsu) else "-"
    ocr_adaptive = daftar_kotak_adaptive[no-1]['text'] if no-1 < len(daftar_kotak_adaptive) else "-"

    baris = [no, teks_sebenarnya, ocr_berwarna, ocr_otsu, ocr_adaptive]
    baris_tabel.append(baris)

# Buat DataFrame pandas
df_perbandingan = pd.DataFrame(baris_tabel, columns=kolom_tabel)
print(df_perbandingan)

# Hitung persentase kecocokan untuk setiap metode
# Asumsi: 10 kata/angka acuan yang kita ambil dari visual KTP secara manual
# Untuk demonstrasi, hitung berapa item yang sesuai (case-insensitive, tanpa spasi)
def hitung_kecocokan(teks_ocr, teks_acuan):
    """Hitung kecocokan antara teks OCR dan teks acuan"""
    if teks_ocr == '-' or teks_acuan == '':
        return 0
    teks_ocr_bersih = teks_ocr.strip().lower()
    teks_acuan_bersih = teks_acuan.strip().lower()
    # Cek apakah teks OCR mengandung teks acuan (substring match)
    if teks_acuan_bersih in teks_ocr_bersih or teks_ocr_bersih in teks_acuan_bersih:
        return 1
    return 0

# Contoh teks acuan dari KTP (DI ISI OLEH USER berdasarkan citra yang digunakan)
teks_acuan_list = [
    "NIK", "NAMA", "TEMPAT LAHIR", "TANGGAL LAHIR", "JENIS KELAMIN",
    "AGAMA", "ALAMAT", "RT/RW", "KECAMATAN"
]

# Hitung kecocokan untuk setiap metode
item_tepat_berwarna = 0
item_tepat_otsu = 0
item_tepat_adaptive = 0

for no in range(n_items):
    if no < len(daftar_kotak_color):
        item_tepat_berwarna += hitung_kecocokan(daftar_kotak_color[no]['text'], teks_acuan_list[no])
    if no < len(daftar_kotak_otsu):
        item_tepat_otsu += hitung_kecocokan(daftar_kotak_otsu[no]['text'], teks_acuan_list[no])
    if no < len(daftar_kotak_adaptive):
        item_tepat_adaptive += hitung_kecocokan(daftar_kotak_adaptive[no]['text'], teks_acuan_list[no])

# Hitung persentase kecocokan
persentase_berwarna = (item_tepat_berwarna / n_items) * 100
persentase_otsu = (item_tepat_otsu / n_items) * 100
persentase_adaptive = (item_tepat_adaptive / n_items) * 100

# Hitung rata-rata confidence untuk masing-masing metode
def rata_rata_confidence(daftar_kotak):
    if len(daftar_kotak) == 0:
        return 0
    total_conf = sum([item['confidence'] for item in daftar_kotak])
    return total_conf / len(daftar_kotak)

rata_conf_berwarna = rata_rata_confidence(daftar_kotak_color)
rata_conf_otsu = rata_rata_confidence(daftar_kotak_otsu)
rata_conf_adaptive = rata_rata_confidence(daftar_kotak_adaptive)

# Tabel ringkasan
print(f"\n=== TABEL RINGKASAN ===")
summary_data = {
    'Citra Masukan': ['Berwarna Asli', 'Segmentasi Otsu', 'Segmentasi Adaptive'],
    'Item Terbaca Tepat': [item_tepat_berwarna, item_tepat_otsu, item_tepat_adaptive],
    'Kecocokan (%)': [f"{persentase_berwarna:.1f}%", f"{persentase_otsu:.1f}%", f"{persentase_adaptive:.1f}%"],
    'Rata-rata Confidence': [f"{rata_conf_berwarna:.1f}", f"{rata_conf_otsu:.1f}", f"{rata_conf_adaptive:.1f}"]
}
df_summary = pd.DataFrame(summary_data)
print(df_summary)

# Jawab 5 pertanyanalisis terkait performa OCR
print("\n=== ANALISIS 5 PERTANYAAN ===")
