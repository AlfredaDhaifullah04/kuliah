      "cell_type": "code",
      "content": "# Tugas 3: Global Thresholding Manual dengan threshold = 200\n# Memuat citra dari Drive (bisa sudoku, lena, atau citra lainnya)\nimage_path = '/content/drive/MyDrive/PCVK/Images/sudoku-original.jpg'\nimg = cv2.imread(image_path, 0)  # Baca grayscale\n\nif img is None:\n    print(f\"Citra tidak ditemukan di: {image_path}\")\n    # Coba cari citra yang ada di Drive\n    import glob\n    files = glob.glob('/content/drive/MyDrive/PCVK/Images/*.jpg')\n    if files:\n        image_path = files[0]\n        img = cv2.imread(image_path, 0)\n        print(f\"Menggunakan citra: {image_path}\")\n    else:\n        print(\"Tidak ada citra di Drive, menggunakan citas bawaan skimage\")\n        from skimage.data import coins\n        img = coins()\n        img = (img * 255).astype(np.uint8)\n\n# Pastikan citra tidak None dan memiliki nilai yang valid\nif img is not None and img.size > 0:\n    # Normalisasi ke range 0-255 jika perlu\n    if img.max() <= 1:\n        img = (img * 255).astype(np.uint8)\n    \n    threshold = 200\n    maxval = 255\n    \n    # Implementasi Manual BINARY: piksel > 200 → 255, lainnya 0\n    binary = np.where(img > threshold, maxval, 0).astype(np.uint8)\n    \n    # Implementasi Manual BINARY_INV: piksel > 200 → 0, lainnya 255\n    binary_inv = np.where(img > threshold, 0, maxval).astype(np.uint8)\n    \n    # Implementasi Manual TRUNC: piksel > 200 → 200, lainnya nilai asli\n    trunc = np.where(img > threshold, threshold, img).astype(np.uint8)\n    \n    # Implementasi Manual TOZERO: piksel > 200 nilai asli tetap, lainnya 0\n    tozero = np.where(img > threshold, img, 0).astype(np.uint8)\n    \n    # Implementasi Manual TOZERO_INV: piksel > 200 → 0, lainnya nilai asli tetap\n    tozero_inv = np.where(img > threshold, 0, img).astype(np.uint8)\n    \n    # Tampilkan hasil dalam grid 2x3\n    titles = ['Original Image', 'BINARY', 'BINARY_INV', 'TRUNC', 'TOZERO', 'TOZERO_INV']\n    images = [img, binary, binary_inv, trunc, tozero, tozero_inv]\n    \n    plt.figure(figsize=(15, 8))\n    for i in range(len(images)):\n        plt.subplot(2, 3, i+1)\n        plt.imshow(images[i], 'gray', interpolation='nearest')\n        plt.title(titles[i])\n        plt.xticks([]), plt.yticks([])\n    plt.suptitle('Tugas 3: Global Thresholding Manual (Threshold = 200)', fontsize=14)\n    plt.tight_layout()\n    plt.show()\n    \n    print(f\"Citra asli memiliki shape: {img.shape}, range nilai: [{img.min()}, {img.max()}]\")\n    print(f\"Threshold yang digunakan: {threshold}\")\nelse:\n    print(\"Gagal memuat citra!\")
