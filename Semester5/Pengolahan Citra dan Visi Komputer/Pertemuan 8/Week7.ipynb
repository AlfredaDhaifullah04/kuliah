      "cell_type": "code",
      "content": "# Tugas 7: Segmentasi Warna Berbasis K-Means (Fokus Warna Biru KTP)\n# Baca citra KTP dan konversi ke ruang warna HSV\nktp_path = '/content/drive/MyDrive/PCVK/Images/ktp_fulan.jpg'\nimg_ktp = cv2.imread(ktp_path)\n\nif img_ktp is None:\n    print(f\"Citra KTP tidak ditemukan di: {ktp_path}\")\n    import glob\n    files = glob.glob('/content/drive/MyDrive/PCVK/Images/ktp*.jpg')\n    if files:\n        ktp_path = files[0]\n        img_ktp = cv2.imread(files[0])\n        print(f\"Menggunakan citra: {ktp_path}\")\n\nif img_ktp is not None:\n    # Konversi dari BGR ke RGB\n    img_rgb = cv2.cvtColor(img_ktp, cv2.COLOR_BGR2RGB)\n    \n    # Konversi ke ruang warna HSV\n    img_hsv = cv2.cvtColor(img_ktp, cv2.COLOR_BGR2HSV)\n    \n    # Siapkan data untuk K-Means clustering\n    # Reshape citra menjadi array 2D (setiap baris adalah satu piksel dengan 3 fitur)\n    H, W, C = img_rgb.shape\n    Z = img_rgb.reshape((-1, 3))\n    Z = np.float32(Z)\n    \n    # Terapkan K-Means clustering\n    from sklearn.cluster import KMeans\n    k = 8  # Jumlah cluster (bisa disesuaikan)\n    kmeans = KMeans(n_clusters=k, random_state=42)\n    kmeans.fit(Z)\n    \n    # Dapatkan label dan pusat cluster\n    labels = kmeans.labels_}\n    centers = np.uint8(kmeans.cluster_centers_)\n    \n    # Bentuk citra hasil segmentasi K-Means\n    segmented = centers[labels.flatten()]\n    segmented_img = segmented.reshape((H, W, C))\n    \n    # --- Filter Warna Biru berdasarkan HSV ---\n    # Definisi rentang HSV untuk warna biru pada latar KTP\n    # H (Hue): 85 s.d. 130, S (Saturation): ≥ 25, V (Value): ≥ 40\n    lower_blue = np.array([85, 25, 40])\n    upper_blue = np.array([130, 255, 255])\n    \n    # Buat mask berdasarkan rentang HSV\n    blue_mask = cv2.inRange(img_hsv, lower_blue, upper_blue)\n    \n    # Apply mask ke citra asli\n    result_blue_only = cv2.bitwise_and(img_ktp, img_ktp, mask=blue_mask)\n    \n    # Tampilkan hasil perbandingan\n    titles = ['Citra KTP Asli', 'Segmentasi K-Means (k=8)', 'Hasil Filter Warna Biru (HSV)']\n    images = [img_ktp, segmented_img, result_blue_only]\n    \n    plt.figure(figsize=(15, 10))\n    for i in range(3):\n        plt.subplot(1, 3, i+1)\n        if i == 0:\n            plt.imshow(cv2.cvtColor(images[i], cv2.COLOR_BGR2RGB) if i == 0 else images[i], 'gray')\n        else:\n            plt.imshow(images[i])\n        plt.title(titles[i])\n        plt.xticks([]), plt.yticks([])\n    \n    plt.suptitle('Tugas 7: Segmentasi Warna Berbasis K-Means vs Filter HSV pada KTP', fontsize=14)\n    plt.tight_layout()\n    plt.show()\n    \n    print(f\"K-Means clustering dengan k={k} applied pada citra KTP\")\n    print(f\"Rentang HSV untuk warna biru: H=[85, 130], S=[25, 255], V=[40, 255]\")\n    print(f\"Jumlah pixel tersegmentasi warna biru: {np.sum(blue_mask)}\")\n    print(f\"Shape citra asli: {img_ktp.shape}\")
