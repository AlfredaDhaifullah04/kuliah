<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>2.2_SCD1_DimProduct_Overwrite</name>
    <description>SCD Type 1 - Overwrite untuk DimProduct. Ekstrak products+productLines dari OLTP, cek ke DimDatabase by productCode, insert baru, update yang lama (semua field selain key di-overwrite).</description>
    <trans_version>1</trans_version>
    <encryption_type>2</encryption_type>
    <created_date>2026/10/27</created_date>
    <modified_date>2026/10/27</modified_date>
    <input_xml></input_xml>
    <output_xml></output_xml>
    <extended_description></extended_description>
    <trans_hash></trans_hash>
    <repository_directory></repository_directory>
    <multithreaded>N</multithreaded>
    <transform_dependencies></transform_dependencies>
    <max_date_diff></max_date_diff>
    <snowballing>N</snowballing>
    <use_batch_id>N</use_batch_id>
    <batch_id></batch_id>
    <use_sequencing>N</use_sequencing>
    <safe_mode>N</safe_mode>
    <partitioning_enabled>N</partitioning_enabled>
  </info>
  <notemaker>
    <note>
      <draw><x>10</x><y>10</y><w>120</w><h>40</h></draw>
      <note>Koneksi OLTP: conn_oltp_legendvehicle (legendvehicle). Koneksi DW: conn_dw_legendvehicle (dw_legendvehicle). Target: dimProduct.</note>
    </note>
  </notemaker>
  <order>
    <hop><from>Table Input</from><to>Select Values</to><enabled>Y</enabled></hop>
    <hop><from>Select Values</from><to>Database Lookup</to><enabled>Y</enabled></hop>
    <hop><from>Database Lookup</from><to>Table Output (Insert)</to><enabled>Y</enabled></hop>
    <hop><from>Database Lookup</from><to>Update</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Table Input</name>
    <type>TableInput</type>
    <description>Ekstraksi data dari OLTP (join products dan productLines)</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method></partitioning>
    <connection>conn_oltp_legendvehicle</connection>
    <is_parameterized_query>N</is_parameterized_query>
    <sql>SELECT p.productCode, p.productName, p.productLine, p.productScale, p.productVendor, p.productDescription, p.quantityInStock, p.buyPrice, p.MSRP, pl.textDescription FROM products p JOIN productLines pl ON p.productLine = pl.productLine</sql>
    <commit_size>1000</commit_size>
  </step>
  <step>
    <name>Select Values</name>
    <type>SelectValues</type>
    <description>Pilih dan rename field (prefix stream)</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method></partitioning>
    <remove>N</remove>
    <fields>
      <field><name>productCode</name><rename>streamProductCode</rename></field>
      <field><name>productName</name><rename>streamProductName</rename></field>
      <field><name>productLine</name><rename>streamProductLine</rename></field>
      <field><name>productScale</name><rename>streamProductScale</rename></field>
      <field><name>productVendor</name><rename>streamProductVendor</rename></field>
      <field><name>productDescription</name><rename>streamProductDescription</rename></field>
      <field><name>quantityInStock</name><rename>streamQuantityInStock</rename></field>
      <field><name>buyPrice</name><rename>streamBuyPrice</rename></field>
      <field><name>MSRP</name><rename>streamMSRP</rename></field>
      <field><name>textDescription</name><rename>streamTextDescription</rename></field>
    </fields>
  </step>
  <step>
    <name>Database Lookup</name>
    <type>DatabaseLookup</type>
    <description>Cek apakah productCode sudah ada di DimProduct</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method></partitioning>
    <connection>conn_dw_legendvehicle</connection>
    <lookup>dimProduct</lookup>
    <key>
      <name>streamProductCode</name>
      <rename>productCode</rename>
    </key>
    <lookup_column>
      <name>productCode</name>
      <rename>productCode</rename>
      <type>String</type>
      <length>...</length>
      <precision>...</precision>
    </lookup_column>
  </step>
  <step>
    <name>Table Output (Insert)</name>
    <type>TableOutput</type>
    <description>Insert produk baru yang belum ada di DimProduct</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method></partitioning>
    <connection>conn_dw_legendvehicle</connection>
    <schema>dw_legendvehicle</schema>
    <table>dimProduct</table>
    <commit>1000</commit>
    <use_batch>N</use_batch>
    <truncate>N</truncate>
    <specify_fields>Y</specify_fields>
    <field><name>streamProductCode</name><column>productCode</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamProductName</name><column>productName</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamProductLine</name><column>productLine</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamProductScale</name><column>productScale</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamProductVendor</name><column>productVendor</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamProductDescription</name><column>productDescription</column><type>String</type><length>...</length><precision>...</precision></field>
    <field><name>streamQuantityInStock</name><column>quantityInStock</column><type>Integer</type><length>...</length><precision>...</precision></field>
    <field><name>streamBuyPrice</name><column>buyPrice</column><type>Number</type><length>...</length><precision>...</precision></field>
    <field><name>streamMSRP</name><column>MSRP</column><type>Number</type><length>...</length><precision>...</precision></field>
    <field><name>streamTextDescription</name><column>textDescription</column><type>String</type><length>...</length><precision>...</precision></field>
  </step>
  <step>
    <name>Update</name>
    <type>Update</type>
    <description>Update produk yang sudah ada (SCD Type 1 - overwrite)</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method></partitioning>
    <connection>conn_dw_legendvehicle</connection>
    <schema>dw_legendvehicle</schema>
    <table>dimProduct</table>
    <commit>1000</commit>
    <use_batch>N</use_batch>
    <key>
      <name>streamProductCode</name>
      <column>productCode</column>
    </key>
    <update>
      <name>streamProductName</name>
      <column>productName</column>
    </update>
    <update>
      <name>streamProductLine</name>
      <column>productLine</column>
    </update>
    <update>
      <name>streamProductScale</name>
      <column>productScale</column>
    </update>
    <update>
      <name>streamProductVendor</name>
      <column>productVendor</column>
    </update>
    <update>
      <name>streamProductDescription</name>
      <column>productDescription</column>
    </update>
    <update>
      <name>streamQuantityInStock</name>
      <column>quantityInStock</column>
    </update>
    <update>
      <name>streamBuyPrice</name>
      <column>buyPrice</column>
    </update>
    <update>
      <name>streamMSRP</name>
      <column>MSRP</column>
    </update>
    <update>
      <name>streamTextDescription</name>
      <column>textDescription</column>
    </update>
  </step>
</transformation>
